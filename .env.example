# Copy to `.env` and fill in. `docker compose` reads this automatically.
# Do NOT commit your real .env (it's gitignored).

# --- LLM (required for coaching turns) ---------------------------------------
# The GeminiAdapter reads GEMINI_API_KEY (or GOOGLE_API_KEY). Without it the
# server runs but /turn fails at the LLM call.
GEMINI_API_KEY=

# Model the orchestrator drives (default shown).
LUCENA_MODEL=gemini-flash-lite-latest

# --- Postgres (the app connects over the compose network) --------------------
POSTGRES_DB=lucena
POSTGRES_USER=lucena
POSTGRES_PASSWORD=lucena

# --- Backend WS/REST port published to the host (mac client connects here) ---
LUCENA_BACKEND_PORT=8766

# --- AGPL §13 source-offer anchor: the engine commit the image is built from.
# Set at build time so distributed images point at the exact Corresponding
# Source:   ENGINE_GIT_SHA=$(git -C engine rev-parse HEAD)
ENGINE_GIT_SHA=
